{
  "/api": {
    "target": "http://localhost:1221",
    "secure": false,
    "changeOrigin": true,
    "logLevel": "debug",
    "ws": true
  },
  "/hubs": {
    "target": "http://localhost:1221",
    "secure": false,
    "ws": true,
    "logLevel": "debug",
    "onError": {
      "function": "function(err, req, res) { console.log('Proxy error:', err.message); }"
    }
  }
}
